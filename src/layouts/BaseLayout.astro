---
import '@fontsource-variable/dm-sans/opsz.css';
import '@fontsource-variable/dm-sans/opsz-italic.css';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url';
import '../styles/global.css';
import imageSizes from '../content/image-sizes.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  ogType?: string;
  /** The page's top photo (the hero). It is preloaded at high priority so it
      starts downloading straight away. Must be the same image the page's CSS
      shows. On phones the page shows the 1080px copy when there is one. */
  heroImage?: string;
  /** Set when the page's CSS shows a different photo on phones than the
      1080px copy, for example the full-size photo. */
  heroImagePhone?: string;
}

const {
  title,
  description = 'Oakdene House Foundation supports people and families affected by addiction, hardship, homelessness, and life challenges in Fairfield, Western Sydney.',
  ogImage = '/images/hero/hero-centre-1.jpg',
  noindex = false,
  ogType = 'website',
  heroImage,
  heroImagePhone,
} = Astro.props;

const heroSizes = heroImage
  ? (imageSizes as Record<string, { variants: Record<string, string> }>)[heroImage]
  : undefined;
const heroSmall = heroImagePhone ?? heroSizes?.variants['1080'];

const siteUrl = 'https://oakdenehouse.org.au';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Oakdene House Foundation" />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logos/oakdene-hero-logo.png" />

    <!-- Start the main font and the hero photo straight away -->
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
    {heroImage && heroSmall && heroSmall !== heroImage && (
      <>
        <link rel="preload" as="image" href={heroSmall} fetchpriority="high" media="(max-width: 768px)" />
        <link rel="preload" as="image" href={heroImage} fetchpriority="high" media="(min-width: 769px)" />
      </>
    )}
    {heroImage && (!heroSmall || heroSmall === heroImage) && (
      <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
    )}

    <title>{title}</title>

    {/* Page-specific head content, such as JSON-LD */}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <!-- <ChatWidget /> -->
  </body>
</html>
